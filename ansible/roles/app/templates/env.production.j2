DATABASE_URL={{ database_url }}

# Auth
JWT_SECRET={{ jwt_secret }}
COOKIE_SECURE={{ cookie_secure }}

# AI provider
AI_BASE_URL={{ ai_base_url }}
AI_API_KEY={{ ai_api_key }}
AI_MODEL={{ ai_model }}
AI_THINKING={{ ai_thinking }}

# Mail (Brevo relay)
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USER={{ smtp_user }}
SMTP_PASSWORD={{ smtp_password }}
MAIL_FROM={{ smtp_from }}

# Slack notifications
SLACK_WEBHOOK_URL={{ slack_webhook_url }}

# Serving under a path prefix (inlined at build time)
NEXT_PUBLIC_BASE_PATH={{ base_path }}
# Public origin for absolute links in emails (proxy can't always be trusted
# to forward the original Host)
APP_ORIGIN={{ app_origin }}

# Node
NODE_ENV=production
