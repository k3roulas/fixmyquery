DATABASE_URL={{ database_url }}

# Auth
JWT_SECRET={{ jwt_secret }}

# AI provider
AI_BASE_URL={{ ai_base_url }}
AI_API_KEY={{ ai_api_key }}
AI_MODEL={{ ai_model }}
AI_THINKING={{ ai_thinking }}

# Mail (Brevo relay)
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USER={{ smtp_user }}
SMTP_PASSWORD={{ smtp_password }}
MAIL_FROM={{ smtp_from }}

# Serving under a path prefix (inlined at build time)
NEXT_PUBLIC_BASE_PATH={{ base_path }}

# Node
NODE_ENV=production
